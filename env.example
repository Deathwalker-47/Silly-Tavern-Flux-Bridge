# Flux LoRA Bridge configuration
# Copy this file to .env and fill only the values you intend to use.
# Never commit your real .env file.

# ---- Core service ----
BRIDGE_PORT=7861
LORA_DICT_PATH=master_lora_dict.json
ENABLE_SUMMARIZATION=true
SUMMARY_MAX_LENGTH=300

# ---- Runware (primary image provider) ----
RUNWARE_API_KEY=
RUNWARE_ENDPOINT=https://api.runware.ai/v1
RUNWARE_MODEL=runware:101@1

# ---- FLUX Kontext image editing (POST /edit, GET /edit-ui) ----
# Instruction-based editing of an existing image. Runs on Runware and reuses
# RUNWARE_API_KEY above; no LoRAs and no prompt summarization are applied.
# Known model AIR ids:
#   bfl:3@1        Kontext [pro] - default, up to 2 reference images
#   bfl:4@1        Kontext [max] - best identity retention, pricier
#   runware:106@1  Kontext [dev] - open weights, honours KONTEXT_STEPS/KONTEXT_CFG
KONTEXT_MODEL=bfl:3@1
# steps/CFG are only sent to models that document them (currently dev only).
KONTEXT_STEPS=28
KONTEXT_CFG=2.5
KONTEXT_TIMEOUT=180
# Upload inputs to Runware and reference them by UUID instead of inlining base64
# in every request. Recommended, especially for photos sent from a phone.
KONTEXT_UPLOAD_IMAGES=true
# Inputs are downscaled to this longest edge before upload (Runware stores 2048 max).
KONTEXT_MAX_EDGE=2048
# Reject inputs larger than this many megabytes.
KONTEXT_MAX_INPUT_MB=25
# Where referenceImages sits in the task payload: auto | inputs | root.
# "auto" sends the documented inputs.referenceImages and retries once at the root.
KONTEXT_REFERENCE_MODE=auto

# ---- Edit endpoint auth ----
# /edit, /edit/immich and /sdapi/v1/img2img spend Runware credits on every call.
# Set a token if this bridge is reachable from the internet; clients send it as
# "Authorization: Bearer <token>" or "X-Edit-Token: <token>".
# Leave empty to keep the endpoints open (a warning is logged at startup).
EDIT_API_TOKEN=

# ---- Immich (optional photo library for edits) ----
# When set, the bridge can read photos out of Immich and write edits back, so the
# Immich API key never has to live on a phone and browsers avoid Immich's CORS
# rules. Leave unset and /edit still works on images the client sends directly.
# Create an API key in Immich under Account Settings -> API Keys.
IMMICH_BASE_URL=
IMMICH_API_KEY=
# Album that edited images are filed into (created automatically if missing).
IMMICH_EDIT_ALBUM=AI Edits
IMMICH_TIMEOUT=60
# Shows up as the source device on uploaded assets.
IMMICH_DEVICE_ID=flux-bridge

# ---- txt2img provider chain ----
# Tried in order. Wavespeed, FAL and Together are deprecated (their clients remain
# in the code; add them here to re-enable).
IMAGE_PROVIDER_ORDER=runware,replicate

# ---- Replicate (Flux backup + video) ----
# flux-dev-multi-lora loads LoRAs straight from the HuggingFace URLs in master_lora_dict.json.
REPLICATE_API_TOKEN=
REPLICATE_FLUX_MODEL=lucataco/flux-dev-multi-lora
MAXLORAS_REPLICATE=6

# ---- Media Studio: images from character avatars (characters without a LoRA) ----
# Separate from KONTEXT_MODEL above (used by the Immich editor). Kontext [dev] is open weights.
AVATAR_KONTEXT_MODEL=runware:106@1

# ---- Media Studio: video providers ----
# A provider shows up in the SillyTavern menus once its key is set. Runware reuses RUNWARE_API_KEY.
NANOGPT_API_KEY=
SOGNI_API_KEY=
# One stable id per installation (generated from the hostname when empty).
SOGNI_APP_ID=
# fast = dedicated GPUs, billed; relaxed = free queue, can take much longer (an hour or more).
# The Media Studio extension can override this per request (Video > Sogni queue).
SOGNI_NETWORK=fast
# Max wait for a relaxed-queue Sogni job, in seconds.
SOGNI_RELAXED_TIMEOUT=3600
# Applied to every MiniMax H3 job on Sogni (VBVR Video Reasoning, prompt adherence). Empty = none.
SOGNI_H3_LORA=h3-vbvr-video-reasoning
SOGNI_H3_LORA_STRENGTH=0.8
VIDEO_JOB_TIMEOUT=1200
VIDEO_STORE_TTL=3600
# Adds a free "mock" provider that returns a bundled test clip (for testing the UI).
VIDEO_MOCK_PROVIDER=false

# ---- Helper LLM (media director, prompt summarizer, TavernVoice voice tags) ----
# Any OpenAI-compatible /chat/completions endpoint. Defaults to NanoGPT with NANOGPT_API_KEY.
HELPER_API_URL=https://nano-gpt.com/api/v1/chat/completions
HELPER_API_KEY=
HELPER_MODEL=deepseek/deepseek-v4.1-flash
# Model for txt2img prompt summarization; empty = HELPER_MODEL.
SUMMARIZER_MODEL=

# ---- Deprecated image providers (not in IMAGE_PROVIDER_ORDER by default) ----
WAVESPEED_API_KEY=
MAXLORAS_WAVESPEED=4
FAL_API_KEY=
MAXLORAS_FAL=3
# Together is only used as the summarizer fallback when no helper LLM key is set.
TOGETHER_API_KEY=
MAXLORAS_TOGETHER=2

# ---- Public image hosting ----
# When enabled, each generated image is cached in memory and served at
# {PUBLIC_BASE_URL}/images/{id} so third parties can fetch it by URL alongside
# the base64 payload (returned in the txt2img response "image_urls" field).
# PUBLIC_BASE_URL must be the publicly reachable address of THIS bridge.
IMAGE_URLS_ENABLED=true
PUBLIC_BASE_URL=https://bridge.midnighttavern.online
IMAGE_STORE_TTL=600
IMAGE_STORE_MAX=200

# ---- Debugging ----
# Set to true to log every streamed token (verbose, for debugging only)
DEBUG_STREAM_TAP=false
